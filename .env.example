# Copie para .env e preencha. O modo demo e os testes não precisam de nada daqui.

# Banco (SQL Server)
DB_SERVER=localhost
DB_NAME=NOTIFICACOES
DB_USER=usuario_app
DB_PASSWORD=troque-esta-senha
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TABELA_FILA=[email].[TB_FILA_DISPARO]

# SendGrid
SENDGRID_API_KEY=SG.sua-chave-aqui
# Opcional: cópia oculta de todos os envios (auditoria)
COPIA_OCULTA=

# Execução
MAX_WORKERS=24
TAMANHO_LOTE_BUSCA=500
TAMANHO_FLUSH_UPDATE=200
# Peso por cedente: cedentes com mais volume recebem mais workers
PESOS_CEDENTES={"10": 2, "20": 1}

# Pasta de logs (padrão: ./logs)
LOG_DIR=
